@model NoticeListViewModel
@{
    var all = L["Notice board"].Value;
    var title = Model.Category is null ? all : L[Model.Category.Label].Value;
    var lead = L["Announcements, government schemes, water and electricity updates, meetings and emergencies."].Value;
    ViewData["Title"] = title;
    ViewData["Description"] = lead;

    // The category and each page are pages of their own for search engines (see PageMeta).
    var canonical = new List<string>();
    if (Model.Category is not null) { canonical.Add("category=" + Model.Category.Slug); }
    if (Model.Pagination.Page > 1) { canonical.Add("page=" + Model.Pagination.Page); }
    ViewData["CanonicalQuery"] = canonical.Count == 0 ? null : "?" + string.Join("&", canonical);

    var header = new PageHeaderViewModel
    {
        Title = title,
        Lead = lead,
        Icon = Model.Category?.Icon ?? "bullhorn",
        Breadcrumbs = Model.Category is null
            ? [new BreadcrumbItem(all)]
            : [new BreadcrumbItem(all, RouteNames.Notices), new BreadcrumbItem(title)]
    };
    var withNotices = Model.Categories.Where(c => c.Count > 0).ToList();
}
<partial name="_PageHeader" model="header" />

<section class="kc-section kc-notices-page">
    <div class="container">
        @if (withNotices.Count > 1 || Model.Category is not null)
        {
            <nav class="kc-filter-chips" aria-label="@L["Categories"]">
                <a class="kc-filter-chip @(Model.Category is null ? "is-active" : null)" aria-current="@(Model.Category is null ? "page" : null)"
                   asp-route="@RouteNames.Notices">@L["All"]</a>
                @foreach (var category in withNotices)
                {
                    var current = category.Category == Model.Category?.Category;
                    <a class="kc-filter-chip @(current ? "is-active" : null)" aria-current="@(current ? "page" : null)"
                       asp-route="@RouteNames.Notices" asp-route-category="@category.Slug">
                        <icon name="@category.Icon" /> @L[category.Label] <span class="kc-filter-count">@category.Count</span>
                    </a>
                }
            </nav>
        }

        @if (Model.Notices.Count == 0)
        {
            <p class="kc-empty">
                @if (Model.Category is null)
                {
                    @L["There are no notices right now."]
                }
                else
                {
                    @L["No notices of this kind right now."]
                    <a asp-route="@RouteNames.Notices">@L["All notices"]</a>
                }
            </p>
        }
        else
        {
            <ul class="kc-notice-list">
                @foreach (var notice in Model.Notices)
                {
                    <li><partial name="Cards/_NoticeItem" model="notice" /></li>
                }
            </ul>
            <partial name="_Pagination" model="Model.Pagination" />
        }

        <p class="kc-page-note">
            <icon name="circle-info" />
            @L["Notices are removed when they end, so the board only shows what is current."]
        </p>
    </div>
</section>
