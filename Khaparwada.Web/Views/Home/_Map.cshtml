@model HomeViewModel
@if (Model.Map is { } map)
{
    var heading = new SectionHeadingViewModel(
        L["Find your way"], L["Village map"], "map-title",
        L["Temples, schools, offices and more. Tap a marker to learn about a place."],
        L["Open the full map"], RouteNames.Map);
    var canvas = new MapCanvasViewModel("home-map", map, L["Interactive map of the village"]);

    <section class="kc-section kc-map-section" id="map" aria-labelledby="map-title">
        <div class="container">
            <partial name="_SectionHeading" model="heading" />
            <partial name="_MapCanvas" model="canvas" />
            <ul class="kc-map-legend">
                @foreach (var category in Model.PlaceCategories.Where(category => category.PlaceCount > 0))
                {
                    <li><icon name="@category.Icon" color="@category.Color" /> @category.Name</li>
                }
            </ul>
        </div>
    </section>
}
