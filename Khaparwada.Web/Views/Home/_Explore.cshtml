@model HomeViewModel
@{
    var heading = new SectionHeadingViewModel(
        L["Explore"], L["Explore {0}", Model.Site.VillageName], "explore-title",
        L["Temples, schools, water places and the other places that make the village home."],
        L["All places"], RouteNames.Places);
}
<section class="kc-section kc-section--sand" id="explore" aria-labelledby="explore-title">
    <div class="container">
        <partial name="_SectionHeading" model="heading" />

        <ul class="kc-category-grid" data-reveal>
            @foreach (var category in Model.PlaceCategories)
            {
                <li><partial name="Cards/_CategoryTile" model="category" /></li>
            }
        </ul>

        @if (Model.FeaturedPlaces.Count > 0)
        {
            <h3 class="kc-subheading">@L["Featured places"]</h3>
            <div class="row g-4">
                @foreach (var place in Model.FeaturedPlaces)
                {
                    <div class="col-sm-6 col-lg-3" data-reveal>
                        <partial name="Cards/_PlaceCard" model="place" />
                    </div>
                }
            </div>
        }
    </div>
</section>
