@model HomeViewModel
@if (Model.ThenNow.Count > 0)
{
    var heading = new SectionHeadingViewModel(
        L["Then & now"], L["How {0} has changed", Model.Site.VillageName], "then-now-title",
        L["Drag the slider to compare the same place, years apart."],
        L["See all"], RouteNames.History, "then-and-now");

    <section class="kc-section kc-section--indigo kc-then-now" aria-labelledby="then-now-title">
        <div class="container">
            <partial name="_SectionHeading" model="heading" />
            <div class="row g-4">
                @foreach (var item in Model.ThenNow)
                {
                    <div class="col-lg-6" data-reveal>
                        <partial name="_ThenNowFigure" model="item" />
                    </div>
                }
            </div>
        </div>
    </section>
}
