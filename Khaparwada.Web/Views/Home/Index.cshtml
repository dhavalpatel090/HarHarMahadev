@model HomeViewModel
@{
    ViewData["Description"] = Model.Site.MetaDescription;
}
@* Section order follows the agreed plan: hero → statistics → about → explore → history → then & now →
   events → notices → gallery → community → map → contact. Each section is a partial in Views/Home. *@
<partial name="_Hero" model="Model.Hero" />
<partial name="_Stats" model="Model" />
<partial name="_About" model="Model" />
<partial name="_Explore" model="Model" />
<partial name="_History" model="Model" />
<partial name="_ThenNow" model="Model" />
<partial name="_Events" model="Model" />
<partial name="_Notices" model="Model" />
<partial name="_Gallery" model="Model" />
<partial name="_Community" model="Model" />
<partial name="_Map" model="Model" />
<partial name="_Contact" model="Model.Site" />

@section Scripts {
    <script src="/js/map.js" asp-append-version="true" defer></script>
    <script src="/js/home.js" asp-append-version="true" defer></script>
}
