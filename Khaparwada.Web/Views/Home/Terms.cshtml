@{
    var title = L["Terms & disclaimer"].Value;
    ViewData["Title"] = title;
    ViewData["Description"] = L["The terms for using Khaparwada Connect and sharing content on it."].Value;
    var header = new PageHeaderViewModel
    {
        Title = title,
        Lead = L["The terms for using this website and for sharing content on it."],
        Icon = "scroll",
        Breadcrumbs = [new BreadcrumbItem(title)]
    };
}
<partial name="_PageHeader" model="header" />

