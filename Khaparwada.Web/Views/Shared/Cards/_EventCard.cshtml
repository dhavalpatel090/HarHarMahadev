@model EventCardViewModel
@{
    var culture = CultureInfo.CurrentCulture;
}
<article class="kc-card kc-event-card">
    <div class="kc-event-date" aria-hidden="true">
        <span class="kc-event-day">@Model.StartsAt.ToString("dd", culture)</span>
        <span class="kc-event-month">@Model.StartsAt.ToString("MMM", culture)</span>
    </div>
    <div class="kc-card-body">
        <h3 class="kc-card-title">
            <a class="stretched-link" asp-route="@RouteNames.EventDetails" asp-route-slug="@Model.Slug">@Model.Title</a>
        </h3>
        <ul class="kc-meta-list">
            <li>
                <icon name="calendar-days" />
                <time datetime="@Model.StartsAt.ToString("O", CultureInfo.InvariantCulture)">@Model.DateText</time>
            </li>
            <li><icon name="clock" /> @(Model.TimeText ?? L["All day"].Value)</li>
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <li><icon name="location-dot" /> @Model.Location</li>
            }
        </ul>
        <p class="kc-card-text">@Model.Summary</p>
    </div>
</article>
