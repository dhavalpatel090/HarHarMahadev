@model NoticeItemViewModel
@{
    var priorityClass = Model.Priority switch
    {
        NoticePriority.Urgent => "is-urgent",
        NoticePriority.Important => "is-important",
        _ => null
    };
    var culture = CultureInfo.CurrentCulture;
}
<article class="kc-notice @priorityClass">
    <span class="kc-notice-icon"><icon name="@Model.Icon" /></span>
    <div class="kc-notice-body">
        <div class="kc-notice-meta">
            @if (Model.Priority == NoticePriority.Urgent)
            {
                <span class="kc-badge kc-badge--urgent">@L["Urgent"]</span>
            }
            else if (Model.Priority == NoticePriority.Important)
            {
                <span class="kc-badge kc-badge--important">@L["Important"]</span>
            }
            <span>@L[Model.CategoryLabel]</span>
            <span aria-hidden="true">·</span>
            <time datetime="@Model.PublishedAt.ToString("O", CultureInfo.InvariantCulture)">@Model.PublishedAt.ToString("d MMM yyyy", culture)</time>
            @if (Model.ValidUntil is { } until)
            {
                <span aria-hidden="true">·</span>
                <span>@L["until {0}", until.ToString("d MMM", culture)]</span>
            }
        </div>
        <h3 class="kc-notice-title">
            <a class="stretched-link" asp-route="@RouteNames.NoticeDetails" asp-route-slug="@Model.Slug">@Model.Title</a>
        </h3>
        @if (!string.IsNullOrWhiteSpace(Model.Excerpt))
        {
            <p class="kc-notice-excerpt">@Model.Excerpt</p>
        }
    </div>
    <icon name="chevron-right" class="kc-notice-arrow" />
</article>
