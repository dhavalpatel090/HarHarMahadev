@model AlbumAdminListViewModel
@{
    ViewData["Title"] = "Gallery";
    ViewData["Lead"] = "Photo albums. An album appears on the website once it has at least one approved photo.";
}
@section Actions {
    <a class="btn btn-kc-outline" href="/gallery" target="_blank" rel="noopener"><icon name="eye" /> View page<span class="visually-hidden"> (opens in a new tab)</span></a>
    <a class="btn btn-kc-primary" asp-action="Create"><icon name="plus" /> Add album</a>
}

@if (Model.WaitingTotal > 0)
{
    <div class="kc-admin-alert kc-admin-alert--warning">
        <icon name="inbox" />
        <span>
            @(Model.WaitingTotal == 1 ? "1 photo is" : $"{Model.WaitingTotal} photos are") waiting for an Admin's approval.
            <a asp-action="Review">Review them</a>
        </span>
    </div>
}

<form class="kc-admin-filters" method="get" asp-route="admin-gallery" role="search">
    <div>
        <label class="kc-field-label" for="filter-category">Category</label>
        <select class="form-select" id="filter-category" name="category">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@(category.Name + (category.IsActive ? "" : " (hidden)"))</option>
            }
        </select>
    </div>
    <div class="kc-admin-filters-grow">
        <label class="kc-field-label" for="filter-q">Name of the album</label>
        <input class="form-control" type="search" id="filter-q" name="q" value="@Model.Search" maxlength="100" />
    </div>
    <button class="btn btn-kc-outline" type="submit"><icon name="magnifying-glass" /> Filter</button>
</form>

<section class="kc-panel" aria-label="Albums">
    @if (Model.Items.Count == 0)
    {
        <p class="kc-panel-empty">No albums found. Change the filter, or add an album with the button above.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table kc-table">
                <thead>
                    <tr>
                        <th scope="col">Album</th>
                        <th scope="col">Category</th>
                        <th scope="col">Photos</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="kc-name-cell">
                                    <partial name="_Thumb" model="item.CoverPath" />
                                    <span>
                                        <strong>@item.Title</strong>
                                        @if (item.TakenOn is { } takenOn)
                                        {
                                            <span class="kc-name-gu">Taken on @takenOn.ToString("d MMM yyyy", CultureInfo.CurrentCulture)</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.TitleGu))
                                        {
                                            <span class="kc-name-gu" lang="gu">@item.TitleGu</span>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td class="kc-nowrap">@item.CategoryName@(item.CategoryIsActive ? null : " (hidden)")</td>
                            <td class="kc-nowrap">
                                <a asp-action="Photos" asp-route-id="@item.Id">@item.Shown<span class="visually-hidden"> photos of @item.Title</span></a>
                                @if (item.Waiting > 0)
                                {
                                    <span class="kc-status is-todo">@item.Waiting waiting</span>
                                }
                            </td>
                            <td>
                                @if (item.IsPlaceholder)
                                {
                                    <span class="kc-status is-todo">Sample</span>
                                }
                                @if (!item.IsPublished || !item.CategoryIsActive)
                                {
                                    <span class="kc-status">Hidden</span>
                                }
                                else if (item.Shown == 0)
                                {
                                    <span class="kc-status">No photos yet</span>
                                }
                                else
                                {
                                    <span class="kc-status is-on">Shown</span>
                                }
                            </td>
                            <td class="kc-table-actions">
                                <a class="btn btn-sm btn-kc-outline" asp-action="Photos" asp-route-id="@item.Id">
                                    <icon name="images" /> Photos<span class="visually-hidden"> of @item.Title</span>
                                </a>
                                <a class="btn btn-sm btn-kc-outline" asp-action="Edit" asp-route-id="@item.Id">
                                    <icon name="pen-to-square" /><span class="visually-hidden">Edit @item.Title</span>
                                </a>
                                <a class="btn btn-sm kc-btn-delete" asp-action="Delete" asp-route-id="@item.Id">
                                    <icon name="trash-can" /><span class="visually-hidden">Delete @item.Title</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<partial name="_Pagination" model="Model.Pagination" />
