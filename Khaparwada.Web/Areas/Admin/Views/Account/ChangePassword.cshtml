@model ChangePasswordInputModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Lead"] = "Choose a password that you do not use on any other website.";
}
<form method="post" asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" class="kc-admin-form kc-admin-form--narrow">
    <div asp-validation-summary="ModelOnly" class="kc-admin-alert kc-admin-alert--error" role="alert"></div>

    <section class="kc-panel">
        <div class="kc-panel-body">
            <div class="kc-field">
                <label asp-for="CurrentPassword" class="kc-field-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="kc-field-error"></span>
            </div>

            <div class="kc-field">
                <label asp-for="NewPassword" class="kc-field-label"></label>
                <p class="kc-field-hint" id="new-password-hint">
                    At least 12 characters, with a capital letter, a small letter, a number and a symbol such as ! or #.
                    A short sentence works well, e.g. “Mango-tree-by-the-well-7”.
                </p>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="new-password-hint" />
                <span asp-validation-for="NewPassword" class="kc-field-error"></span>
            </div>

            <div class="kc-field">
                <label asp-for="ConfirmPassword" class="kc-field-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="kc-field-error"></span>
            </div>
        </div>
    </section>

    <div class="kc-form-actions">
        <button type="submit" class="btn btn-kc-primary">Change password</button>
        <a class="btn btn-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
