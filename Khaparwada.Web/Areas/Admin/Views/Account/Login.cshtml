@model LoginInputModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<h1 class="kc-auth-title">Admin sign in</h1>
<p class="kc-auth-lead">For the team that looks after the village website.</p>

<form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login">
    <div asp-validation-summary="ModelOnly" class="kc-admin-alert kc-admin-alert--error" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="kc-field">
        <label asp-for="Email" class="kc-field-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="kc-field-error"></span>
    </div>

    <div class="kc-field">
        <label asp-for="Password" class="kc-field-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="kc-field-error"></span>
    </div>

    <button type="submit" class="btn btn-kc-primary btn-lg w-100">Sign in</button>
</form>

<p class="kc-auth-note">
    Forgotten your password? Ask the site administrator to reset it.
    After 5 wrong passwords the account is locked for 15 minutes.
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
