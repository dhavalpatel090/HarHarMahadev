@model IReadOnlyList<AboutSectionListItem>
@inject Khaparwada.Web.Services.Common.IVillageClock Clock
@{
    ViewData["Title"] = "About page";
    ViewData["Lead"] = "The sections of the public About page, in the order shown. Milestones come from the History timeline.";
}
@section Actions {
    <a class="btn btn-kc-outline" href="/about" target="_blank" rel="noopener"><icon name="eye" /> View page<span class="visually-hidden"> (opens in a new tab)</span></a>
    <a class="btn btn-kc-primary" asp-action="Create"><icon name="plus" /> Add section</a>
}

<section class="kc-panel" aria-label="About page sections">
    @if (Model.Count == 0)
    {
        <p class="kc-panel-empty">No sections yet. Add the first one with the button above.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table kc-table">
                <thead>
                    <tr>
                        <th scope="col">Order</th>
                        <th scope="col">Section</th>
                        <th scope="col">Web address</th>
                        <th scope="col">Status</th>
                        <th scope="col">Last changed</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SortOrder</td>
                            <td>
                                <div class="kc-name-cell">
                                    <partial name="_Thumb" model="item.ImagePath" />
                                    <span>
                                        <strong>@item.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.TitleGu))
                                        {
                                            <span class="kc-name-gu" lang="gu">@item.TitleGu</span>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td><code class="kc-code">#@item.Slug</code></td>
                            <td>
                                @if (item.IsPlaceholder)
                                {
                                    <span class="kc-status is-todo">To write</span>
                                }
                                else if (item.IsPublished)
                                {
                                    <span class="kc-status is-on">Shown</span>
                                }
                                else
                                {
                                    <span class="kc-status">Hidden</span>
                                }
                            </td>
                            <td class="kc-nowrap">@Clock.ToVillageTime(item.UpdatedAt).ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                            <td class="kc-table-actions">
                                <a class="btn btn-sm btn-kc-outline" asp-action="Edit" asp-route-id="@item.Id">
                                    <icon name="pen-to-square" /> Edit<span class="visually-hidden"> @item.Title</span>
                                </a>
                                <a class="btn btn-sm kc-btn-delete" asp-action="Delete" asp-route-id="@item.Id">
                                    <icon name="trash-can" /><span class="visually-hidden">Delete @item.Title</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
